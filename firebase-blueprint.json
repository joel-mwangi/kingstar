{
  "entities": {
    "User": {
      "title": "User",
      "description": "Firebase-authenticated application user profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "loginId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 256 },
        "email": { "type": "string", "maxLength": 256 },
        "currency": { "type": "string", "maxLength": 10 },
        "balance": { "type": "number" },
        "equity": { "type": "number" },
        "derivAccountId": { "type": "string", "maxLength": 128 },
        "derivAccountIsVirtual": { "type": "boolean" }
      },
      "required": ["userId", "loginId", "currency", "balance", "equity"]
    },
    "Strategy": {
      "title": "Strategy",
      "description": "Deterministic strategy and risk configuration",
      "type": "object",
      "properties": {
        "minProbability": { "type": "number" },
        "minExpectedReturn": { "type": "number" },
        "maxRiskPerTradePercent": { "type": "number" },
        "maxDailyLoss": { "type": "number" },
        "maxPositionSize": { "type": "number" },
        "defaultDuration": { "type": "number" },
        "defaultDurationUnit": { "type": "string", "enum": ["s", "m", "h"] },
        "activeModel": { "type": "string" }
      },
      "required": ["minProbability", "minExpectedReturn", "maxRiskPerTradePercent", "maxDailyLoss", "maxPositionSize", "defaultDuration", "defaultDurationUnit"]
    }
  }
}
